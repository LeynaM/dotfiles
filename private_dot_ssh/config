# Home network hosts. Resolved by LAN DNS (homeserver -> homeserver.localdomain),
# so no VPN/overlay network is needed while on the home network.
Host homeserver
    User user
    StrictHostKeyChecking accept-new

Host homeserver-git
    HostName homeserver
    User git
    StrictHostKeyChecking accept-new

Host backuppi
    User user
    IdentityFile ~/.ssh/backuppi
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
